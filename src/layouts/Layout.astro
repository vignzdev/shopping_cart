---
import { CartBadge } from "@/components/CartBadge";
import { Navbar } from "@/components/Navbar";
import {
	ChevronDown,
	Heart,
	HeartHandshake,
	Hexagon,
	Search,
	ShoppingCart,
	User,
} from "lucide-react";
import "./global.css";

interface Props {
	title?: string;
}

const { title = "Shopping Cart" } = Astro.props;
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="min-h-screen bg-background text-foreground">
		<header>
			<div class="bg-neutral-950 text-white">
				<div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-2.5 sm:px-6">
					<a href="/" class="flex items-center gap-2 text-sm font-semibold tracking-tight">
						<Hexagon class="size-5 fill-white text-white" />
						Shopy
					</a>

					<div class="flex items-center gap-4 text-xs sm:gap-5">
						<div class="group relative hidden sm:block">
							<button
								type="button"
								class="flex items-center gap-1.5 text-white/90 transition hover:text-white"
							>
								<HeartHandshake class="size-3.5" />
								Help & Support
								<ChevronDown class="size-3" />
							</button>
							<div
								class="invisible absolute right-0 z-50 pt-2 opacity-0 transition group-hover:visible group-hover:opacity-100"
							>
								<div class="min-w-40 rounded-md bg-white py-1 text-neutral-800 shadow-md">
									<a href="#" class="block px-3 py-2 text-xs hover:bg-neutral-100">FAQ</a>
									<a href="#" class="block px-3 py-2 text-xs hover:bg-neutral-100">Contact</a>
									<a href="#" class="block px-3 py-2 text-xs hover:bg-neutral-100">Shipping</a>
								</div>
							</div>
						</div>

						<a
							href="#"
							class="flex items-center gap-1.5 text-white/90 transition hover:text-white"
						>
							<Heart class="size-3.5" />
							<span class="hidden sm:inline">Wishlist</span>
						</a>

						<a
							href="#"
							class="flex items-center gap-1.5 text-white/90 transition hover:text-white"
						>
							<User class="size-3.5" />
							<span class="hidden sm:inline">Account</span>
						</a>

						<button
							type="button"
							class="text-white/90 transition hover:text-white"
							aria-label="Search"
						>
							<Search class="size-4" />
						</button>

						<a
							href="/cart"
							class="relative inline-flex text-white/90 transition hover:text-white"
							aria-label="Cart"
						>
							<ShoppingCart class="size-4" />
							<CartBadge client:load />
						</a>
					</div>
				</div>
			</div>
			<Navbar client:load currentPath={path} />
		</header>
		<main>
			<slot />
		</main>
	</body>
</html>
