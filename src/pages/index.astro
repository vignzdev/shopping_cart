---
import { DEFAULT_PAGE_TITLE } from "@/constants/app";
import { FeaturedProducts } from "../components/FeaturedProducts";
import Layout from "../layouts/Layout.astro";
---

<Layout title={DEFAULT_PAGE_TITLE}>
	<section class="relative overflow-hidden bg-white">
		<div class="mx-auto grid max-w-7xl items-center gap-10 px-4 py-16 sm:px-6 lg:grid-cols-2 lg:py-24">
			<div>
				<p class="text-sm font-medium tracking-wide text-muted-foreground">New Arrivals</p>
				<h1 class="mt-3 max-w-lg text-4xl font-semibold tracking-tight sm:text-5xl lg:text-6xl">
					Up 70% Off Deals deals on Headphones
				</h1>
			
				<a
					href="#featured"
					class="mt-8 inline-flex h-11 items-center rounded-md bg-neutral-950 px-6 text-sm font-medium text-white transition hover:bg-neutral-800"
				>
					Shop now
				</a>
			</div>
			<div class="relative aspect-4/3 overflow-hidden rounded-2xl bg-white">
				<img
					src="https://pub-fcd8b1c710ee42c3aef465c871768d69.r2.dev/product_banner/headphone.jpg"
					alt="Headphones"
					class="h-full w-full object-contain"
				/>
			</div>
		</div>
	</section>

	<FeaturedProducts client:load />
</Layout>
